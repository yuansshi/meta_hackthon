# Copy to server/.env and fill in. Never commit .env.
# Meta Model API key (dev.meta.ai): Muse Spark, Muse Wonder, Muse Voice Transcribe
META_API_KEY=
# Optional: Fireworks key for the Muse Spark Open fallback brain (open weights)
FIREWORKS_API_KEY=
# Optional: pick the brain from config/models.yaml (default: `brain:` in that file)
EVERYMUSE_BRAIN=
